.banner{border-radius:28px;padding:70px 60px;background:linear-gradient(120deg,rgba(34,230,255,.1),rgba(139,92,246,.14),rgba(244,114,208,.1));border:1px solid rgba(139,92,246,.3);position:relative;overflow:hidden;display:grid;grid-template-columns:1.2fr 1fr;gap:50px;align-items:center}
.banner h2{margin-bottom:14px}
.banner p{color:var(--muted);margin-bottom:32px}
.big-nums{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.big-num{background:rgba(5,7,15,.5);border:1px solid rgba(255,255,255,.1);border-radius:18px;padding:26px;text-align:center}
.big-num h3{font-size:2rem;background:linear-gradient(92deg,var(--cyan),var(--magenta));-webkit-background-clip:text;background-clip:text;color:transparent}
