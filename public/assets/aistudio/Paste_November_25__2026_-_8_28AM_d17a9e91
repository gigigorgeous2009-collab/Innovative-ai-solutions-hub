@media(max-width:900px){
  .nav-links{position:fixed;inset:0;background:rgba(5,7,15,.96);backdrop-filter:blur(20px);flex-direction:column;justify-content:center;font-size:1.4rem;gap:30px;transform:translateX(100%);transition:.4s}
  .nav-links.open{transform:translateX(0)}
  .burger{display:flex}
  .banner,.contact-grid{grid-template-columns:1fr;padding:44px 30px}
  .foot-grid{grid-template-columns:1fr 1fr}
  .form-row{grid-template-columns:1fr}
  #hero{padding-top:130px}
}
</style>
</head>
