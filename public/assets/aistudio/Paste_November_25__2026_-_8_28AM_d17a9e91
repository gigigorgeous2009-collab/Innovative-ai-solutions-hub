.nav-links{display:flex;gap:34px;align-items:center}
.nav-links a{font-size:.92rem;color:var(--muted);transition:.25s;position:relative}
.nav-links a:hover{color:#fff}
.nav-links a::after{content:'';position:absolute;left:0;bottom:-6px;width:0;height:2px;background:linear-gradient(90deg,var(--cyan),var(--violet));transition:.3s;border-radius:2px}
