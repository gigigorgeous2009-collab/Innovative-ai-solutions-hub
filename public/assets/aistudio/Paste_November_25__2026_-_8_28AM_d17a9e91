<script>
/* ============ 3D NEURAL PARTICLE FIELD ============ */
(function(){
  const canvas = document.getElementById('webgl');
  const renderer = new THREE.WebGLRenderer({canvas, alpha:true, antialias:true});
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, innerWidth/innerHeight, .1, 100);
  camera.position.z = 8;

  // Particle points
  const COUNT = 900;
  const pos = new Float32Array(COUNT*3), cols = new Float32Array(COUNT*3);
  const cA = new THREE.Color('#22e6ff'), cB = new THREE.Color('#8b5cf6'), cC = new THREE.Color('#f472d0');
  const base = [];
  for(let i=0;i<COUNT;i++){
    const x=(Math.random()-.5)*22, y=(Math.random()-.5)*14, z=(Math.random()-.5)*12;
    pos.set([x,y,z], i*3); base.push(x,y,z);
    const c = [cA,cB,cC][Math.floor(Math.random()*3)];
    cols.set([c.r,c.g,c.b], i*3);
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(pos,3));
  geo.setAttribute('color', new THREE.BufferAttribute(cols,3));
  const mat = new THREE.PointsMaterial({size:.06, vertexColors:true, transparent:true, opacity:.85, blending:THREE.AdditiveBlending, depthWrite:false});
  const points = new THREE.Points(geo, mat);
  scene.add(points);

  // Connection lines
  const linePos = new Float32Array(COUNT*8*3);
  const lineGeo = new THREE.BufferGeometry();
  lineGeo.setAttribute('position', new THREE.BufferAttribute(linePos,3));
  const lines = new THREE.LineSegments(lineGeo, new THREE.LineBasicMaterial({color:0x8b5cf6, transparent:true, opacity:.12, blending:THREE.AdditiveBlending}));
  scene.add(lines);

  let mouseX=0, mouseY=0;
  addEventListener('mousemove', e=>{
    mouseX=(e.clientX/innerWidth-.5)*2; mouseY=(e.clientY/innerHeight-.5)*2;
    document.getElementById('glow').style.left=e.clientX+'px';
    document.getElementById('glow').style.top=e.clientY+'px';
  });

  function resize(){ renderer.setSize(innerWidth, innerHeight); camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix(); }
  addEventListener('resize', resize); resize();

  const pAttr = geo.attributes.position.array;
  let t=0;
  (function animate(){
    requestAnimationFrame(animate);
    t+=.0025;
    for(let i=0;i<COUNT;i++){
      const i3=i*3;
      pAttr[i3]   = base[i3]   + Math.sin(t*2 + i)*0.35;
      pAttr[i3+1] = base[i3+1] + Math.cos(t*1.6 + i*0.7)*0.35;
      pAttr[i3+2] = base[i3+2] + Math.sin(t + i*1.3)*0.3;
    }
    geo.attributes.position.needsUpdate = true;

    // rebuild nearby links
    let lp=0; const maxD=1.6;
    for(let i=0;i<COUNT;i+=6){
      for(let j=i+6;j<COUNT;j+=6){
        const dx=pAttr[i*3]-pAttr[j*3], dy=pAttr[i*3+1]-pAttr[j*3+1], dz=pAttr[i*3+2]-pAttr[j*3+2];
        if(dx*dx+dy*dy+dz*dz < maxD*maxD){
          linePos.set([pAttr[i*3],pAttr[i*3+1],pAttr[i*3+2], pAttr[j*3],pAttr[j*3+1],pAttr[j*3+2]], lp); lp+=6;
          if(lp >= linePos.length-6) break;
        }
      }
    }
    for(let k=lp;k<linePos.length;k++) linePos[k]=0;
    lineGeo.attributes.position.needsUpdate = true;

    points.rotation.y = t*.5 + mouseX*.15;
    points.rotation.x = mouseY*.1;
    lines.rotation.copy(points.rotation);
    renderer.render(scene, camera);
  })();
})();

/* ============ GSAP SCROLL ANIMATIONS ============ */
gsap.registerPlugin(ScrollTrigger);
document.querySelectorAll('.reveal').forEach((el,i)=>{
  gsap.to(el,{opacity:1,y:0,duration:.9,ease:'power3.out',delay:(i%4)*.08,
    scrollTrigger:{trigger:el,start:'top 88%'}});
});
gsap.to('#hero .container',{scrollTrigger:{trigger:'#hero',start:'top top',end:'bottom top',scrub:1},y:120,opacity:.35});

/* ============ COUNTERS ============ */
document.querySelectorAll('[data-count]').forEach(el=>{
  const target=+el.dataset.count;
  ScrollTrigger.create({trigger:el,start:'top 90%',once:true,onEnter:()=>{
    gsap.to({v:0},{v:target,duration:1.8,ease:'power2.out',onUpdate:function(){el.textContent=Math.round(this.targets()[0].v);}});
  }});
});

/* ============ CARD SPOTLIGHT ============ */
document.querySelectorAll('.card').forEach(c=>{
  c.addEventListener('mousemove',e=>{
    const r=c.getBoundingClientRect();
    c.style.setProperty('--mx',(e.clientX-r.left)+'px');
    c.style.setProperty('--my',(e.clientY-r.top)+'px');
  });
});

/* ============ NAV / MOBILE MENU ============ */
const header=document.getElementById('header'), burger=document.getElementById('burger'), navLinks=document.getElementById('navLinks');
addEventListener('scroll',()=>header.classList.toggle('scrolled',scrollY>40));
burger.addEventListener('click',()=>navLinks.classList.toggle('open'));
navLinks.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>navLinks.classList.remove('open')));

/* ============ HERO TYPEWRITER ============ */
(function(){
  const el=document.getElementById('typeTarget');
  const phrases=['work while you sleep.','scale without headcount.','turn data into revenue.','never call in sick.'];
  let pi=0, ci=phrases[0].length, del=true;
  (function tick(){
    const cur=phrases[pi];
    if(del){ ci--; if(ci<=0){del=false; pi=(pi+1)%phrases.length;} }
    else { ci++; if(ci>=phrases[pi].length){ del=true; setTimeout(tick,2200); el.textContent=phrases[pi]; return; } }
    el.textContent=phrases[pi].slice(0,ci) + (ci%2?'▌':'');
    setTimeout(tick, del?45:75);
  })();
})();

/* ============ FORM ============ */
document.getElementById('contactForm').addEventListener('submit',e=>{
  e.preventDefault();
  const f=e.target;
  if(!f.name.value.trim()||!f.email.value.includes('@')||!f.message.value.trim()){
    gsap.fromTo(f,{x:-8},{x:0,duration:.4,ease:'elastic.out(1,.3)'}); return;
  }
  const btn=f.querySelector('button');
  btn.textContent='Sending…'; btn.disabled=true;
  setTimeout(()=>{
    btn.textContent='✓ Message Sent'; btn.style.background='linear-gradient(92deg,#22c55e,#22e6ff)';
    document.getElementById('formMsg').style.display='block';
    f.querySelectorAll('input,textarea').forEach(i=>i.value='');
    setTimeout(()=>{btn.textContent='Send Message →';btn.disabled=false;btn.style.background='';},4000);
  },1200);
});
</script>
