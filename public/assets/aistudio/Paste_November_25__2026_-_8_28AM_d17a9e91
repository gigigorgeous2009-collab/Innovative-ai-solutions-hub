#hero{min-height:100vh;display:flex;align-items:center;padding:150px 0 90px}
#webgl{position:fixed;inset:0;z-index:0;pointer-events:none}
.hero-badge{display:inline-flex;align-items:center;gap:10px;padding:8px 18px;border-radius:100px;background:rgba(139,92,246,.12);border:1px solid rgba(139,92,246,.35);font-size:.82rem;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:28px}
