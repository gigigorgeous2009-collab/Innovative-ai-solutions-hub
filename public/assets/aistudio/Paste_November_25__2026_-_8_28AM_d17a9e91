.card .icon{width:56px;height:56px;border-radius:15px;display:grid;place-items:center;margin-bottom:22px;background:linear-gradient(135deg,rgba(34,230,255,.16),rgba(139,92,246,.16));border:1px solid rgba(139,92,246,.35)}
