.card p{color:var(--muted);font-size:.94rem}
.card .link{display:inline-flex;gap:8px;align-items:center;margin-top:20px;color:var(--cyan);font-size:.9rem;font-weight:600;opacity:.85;transition:.25s}
.card:hover .link{gap:14px}
