.grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px}
.card{position:relative;background:var(--panel);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius);padding:36px 30px;transition:.35s;overflow:hidden;backdrop-filter:blur(8px)}
