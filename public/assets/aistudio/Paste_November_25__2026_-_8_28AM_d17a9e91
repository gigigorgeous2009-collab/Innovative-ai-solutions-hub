.container{width:min(1180px,92%);margin:0 auto}
.mono{font-family:'JetBrains Mono',monospace}
.grad-text{background:linear-gradient(92deg,var(--cyan) 0%,var(--violet) 55%,var(--magenta) 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
